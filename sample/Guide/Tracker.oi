	2026-10-12,Pull,470,73.6
	2026-10-15,Legs,540,73.7
	2026-10-19,Push,410,73.8
	2026-10-22,Pull,480,73.3
	2026-10-26,Legs,560,73.1
	2026-10-29,Push,440,72.9
	2026-11-02,Pull,500,72.6

Grid {Gap: 16px}:
	Column {Width: 50%}:
		Plot {Data: Gym log}:
			(Date, Weight) {Kind: Line, Trend: Linear}
	Column {Width: 50%}:
		Plot {Data: Gym log}:
			(Workout, Workout) {Kind: Donut, Combine: Count, Label: Workouts}

Calendar {Show: Month, Date: 2026-10-01, Data: Gym log}:
